        {
          "name": "Get Borrowing by ID (direct)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{borrowing_service_url}}/api/v1/borrowings/{{borrowing_id}}",
              "host": ["{{borrowing_service_url}}"],
