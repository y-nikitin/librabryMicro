    {
      "name": "Config",
      "description": "Demonstrates runtime config refresh via Spring Cloud Bus.\n\nWorkflow:\n1. Call 'Debug Config (borrowing-service)' to see current values\n2. Edit a value in configuration/ (e.g. book-service.books-path)\n3. Call 'Bus Refresh (via config-server)' to push changes\n4. Call 'Debug Config (borrowing-service)' again to verify the update",
      "item": [
        {
          "name": "get config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{borrowing_service_url}}/api/v1/debug/config",
              "host": ["{{borrowing_service_url}}"],
              "path": ["api", "v1", "debug", "config"]
            }
          },
          "response": []
        },
        {
          "name": "full refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{config_server_url}}/actuator/busrefresh",
              "host": ["{{config_server_url}}"],
              "path": ["actuator", "busrefresh"]
            }
          },
          "response": []
        },
        {
          "name": "refresh borrowing-service",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{borrowing_service_url}}/actuator/refresh",
              "host": ["{{borrowing_service_url}}"],
              "path": ["actuator", "refresh"]
            }
          },
          "response": []
        }
      ]
    }
