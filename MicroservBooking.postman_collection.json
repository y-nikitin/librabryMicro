{
  "info": {
    "_postman_id": "b82fdf32-f087-43e0-8cbb-aea5c308a367",
    "name": "MicroservBooking",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "6754471"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "book_service_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "borrowing_service_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "notification_service_url",
      "value": "http://localhost:8083"
    },
    {
      "key": "config_server_url",
      "value": "http://localhost:8888"
    },
    {
      "key": "book_id",
      "value": "1"
    },
    {
      "key": "borrowing_id",
      "value": "1"
    },
    {
      "key": "jwt_token",
      "value": "<your-jwt-token>"
    }
  ],
  "item": [
    {
      "name": "API Gateway",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get Borrowing Details (Aggregated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/library/borrowings/{{borrowing_id}}/details",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "library", "borrowings", "{{borrowing_id}}", "details"]
            }
          },
          "response": []
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/books/{{book_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "books", "{{book_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Reserve Book",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/books/{{book_id}}/reserve",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "books", "{{book_id}}", "reserve"]
            }
          },
          "response": []
        },
        {
          "name": "Release Book",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/books/{{book_id}}/release",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "books", "{{book_id}}", "release"]
            }
          },
          "response": []
        },
        {
          "name": "Create Borrowing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1,\n  \"borrower\": \"John Doe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/borrowings",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "borrowings"]
            }
          },
          "response": []
